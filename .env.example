# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Optional: pin a specific Price. If unset, Keel resolves the price by lookup_key "keel".
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Optional. Defaults to purchases, which is what the bundled migration creates.
KEEL_PURCHASES_TABLE=purchases

# Resend
RESEND_API_KEY=re_...
KEEL_FROM_EMAIL=Your Name <you@your-verified-domain.com>

# Optional. Inferred from Vercel when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
